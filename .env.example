# =============================================================================
# TCC - Configuração de Variáveis de Ambiente
# =============================================================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env: copy .env.example .env
# 2. Preencha os valores abaixo com suas credenciais
# 3. NUNCA commite o arquivo .env no repositório!
#
# =============================================================================

# --- Configuração Obrigatória ---
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=sua_chave_api_aqui

# --- Configuração do Modelo LLM ---
# Modelos atuais (Google AI Studio): gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
# Não use "models/" no nome - a API adiciona automaticamente
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- Execução do código de diagrama gerado pelo LLM (legado) ---
# Desligada por padrão: o diagrama confiável vem do grafo + GRAPH_RENDER.
# Só ligue se quiser voltar a executar matplotlib/degrau/pzmap escritos pelo modelo.
EXECUTE_DIAGRAM_CODE=false
DIAGRAM_EXECUTION_TIMEOUT=45
# Salva PNGs gerados automaticamente em diagrams/ (relativo à raiz do repo)
DIAGRAM_SAVE_TO_DISK=true
DIAGRAM_OUTPUT_DIR=diagrams

# --- Verificação da FT (SymPy + gabaritos canônicos) ---
FT_VERIFICATION_ENABLED=true

# --- Validação estrutural do diagrama por grafo (Fórmula de Ganho de Mason) ---
GRAPH_VALIDATION_ENABLED=true

# --- Renderização determinística do diagrama a partir do grafo (caminho principal) ---
GRAPH_RENDER_ENABLED=true

# --- Ensemble (voto escolhe a análise completa devolvida) ---
# Cada provedor só participa se a chave correspondente estiver preenchida;
# são necessários pelo menos 2 provedores para haver voto.
ENSEMBLE_ENABLED=true
ENSEMBLE_TIMEOUT=60
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Groq: tier gratuito, sem cartão de crédito. Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Configuração do Servidor ---
HOST=127.0.0.1
PORT=8000
DEBUG=false

# --- Configuração de CORS ---
# Em produção, especifique os domínios permitidos separados por vírgula
# Exemplo: CORS_ORIGINS=https://meusite.com,https://app.meusite.com
CORS_ORIGINS=*

# --- Configuração de Logging ---
# Níveis: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
